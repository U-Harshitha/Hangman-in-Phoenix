<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#0b0c12" />
    <meta
      name="description"
      content="Hangman, rebuilt with Elixir & Phoenix LiveView. Guess the word before the last flame goes out."
    />
    <meta property="og:title" content="Hangman · in Phoenix" />
    <meta
      property="og:description"
      content="A real-time word game built with Elixir, Phoenix LiveView, GSAP and Three.js."
    />
    <.live_title default="Hangman" suffix=" · in Phoenix">{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/hangman/images/favicon.svg"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    />
    <link phx-track-static rel="stylesheet" href={~p"/hangman/assets/css/app.css"} />
    <script defer phx-track-static type="module" src={~p"/hangman/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
